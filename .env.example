# Credentials live in a machine-local secrets file, NOT in the environment and
# NOT in this repository. The MCP server reads that file directly, so it does
# not matter whether the shell that launched Claude Code exported anything.
#
# Create ~/.config/claude-secrets.env and chmod 600 it. Add only the mailboxes
# this machine should reach:
#
#   export ALCHLIGHT_MAIL_USER=you@alchlight.com
#   export ALCHLIGHT_MAIL_PASSWORD=your-mailbox-password
#
#   export GMAIL_USER=you@gmail.com
#   export GMAIL_APP_PASSWORD=your-16-character-google-app-password
#
#   chmod 600 ~/.config/claude-secrets.env
#
# Gmail requires a Google App Password, not your account password.
# NEVER commit a filled-in copy of this file. Each person uses their OWN mailbox.
#
# The keys each server reads are set by --user-key and --password-key in
# .mcp.json, so adding a third mailbox is one more server entry there.
