# Copy this to set your own mailbox credentials, then export them before
# launching Claude Code (e.g. add to ~/.bashrc, ~/.zshrc, or a direnv .envrc).
#
#   export IMAP_USER=...
#   export IMAP_PASSWORD=...
#
# NEVER commit a filled-in copy of this file. Each person uses their OWN mailbox.

# Required — your mailbox login:
export IMAP_USER="you@alchlight.com"
export IMAP_PASSWORD="your-mailbox-password"

# Optional — defaults target the Alchlight HostGator server. Override only if
# your mailbox lives elsewhere.
# export IMAP_HOST="gator3272.hostgator.com"
# export IMAP_PORT="993"
# export IMAP_TLS="true"
# export SMTP_HOST="gator3272.hostgator.com"
# export SMTP_PORT="465"
# export SMTP_SECURE="true"
