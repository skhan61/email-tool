{
  "mcpServers": {
    "alchlight-email": {
      "type": "stdio",
      "command": "python3",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/mailbox_mcp/__main__.py",
        "--label", "alchlight",
        "--imap-host", "gator3272.hostgator.com",
        "--imap-port", "993",
        "--user-key", "ALCHLIGHT_MAIL_USER",
        "--smtp-host", "gator3272.hostgator.com",
        "--smtp-port", "465",
        "--secrets-file", "${HOME}/.config/claude-secrets.env",
        "--password-key", "ALCHLIGHT_MAIL_PASSWORD"
      ]
    }
  }
}
