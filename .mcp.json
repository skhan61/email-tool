{
  "mcpServers": {
    "alchlight-email": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "imap-email-mcp@1.0.0"],
      "env": {
        "IMAP_HOST": "${IMAP_HOST:-gator3272.hostgator.com}",
        "IMAP_PORT": "${IMAP_PORT:-993}",
        "IMAP_TLS": "${IMAP_TLS:-true}",
        "IMAP_USER": "${IMAP_USER}",
        "IMAP_PASSWORD": "${IMAP_PASSWORD}",
        "SMTP_HOST": "${SMTP_HOST:-gator3272.hostgator.com}",
        "SMTP_PORT": "${SMTP_PORT:-465}",
        "SMTP_SECURE": "${SMTP_SECURE:-true}"
      }
    }
  }
}
