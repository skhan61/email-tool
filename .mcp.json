{
  "mcpServers": {
    "alchlight": {
      "type": "stdio",
      "command": "python3",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/mailbox_mcp/__main__.py",
        "--label",
        "alchlight",
        "--imap-host",
        "gator3272.hostgator.com",
        "--imap-port",
        "993",
        "--smtp-host",
        "gator3272.hostgator.com",
        "--smtp-port",
        "465"
      ],
      "env": {
        "MAILBOX_USER": "${user_config.alchlight_address}",
        "MAILBOX_PASSWORD": "${user_config.alchlight_password}"
      }
    },
    "gmail": {
      "type": "stdio",
      "command": "python3",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/mailbox_mcp/__main__.py",
        "--label",
        "gmail",
        "--imap-host",
        "imap.gmail.com",
        "--imap-port",
        "993",
        "--smtp-host",
        "smtp.gmail.com",
        "--smtp-port",
        "465"
      ],
      "env": {
        "MAILBOX_USER": "${user_config.gmail_address}",
        "MAILBOX_PASSWORD": "${user_config.gmail_password}"
      }
    }
  }
}
