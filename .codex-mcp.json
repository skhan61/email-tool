{
  "mcpServers": {
    "email": {
      "command": "uvx",
      "args": [
        "--from",
        "email-tool-mcp==5.6.0",
        "email-tool-mcp",
        "serve"
      ],
      "env_vars": [
        "DBUS_SESSION_BUS_ADDRESS",
        "XDG_RUNTIME_DIR"
      ],
      "startup_timeout_sec": 120
    }
  }
}
